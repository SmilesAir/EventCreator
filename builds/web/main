module.exports.buildUrl = function (key, pathParams, queryParams) {
  var url = urls[key];
  for (var wildName in pathParams) {
    url = url.replace("<".concat(wildName, ">"), encodeURIComponent(pathParams[wildName]));
  }
  var firstQueryParam = true;
  for (var paramName in queryParams) {
    var prefix = firstQueryParam ? "?" : "&";
    firstQueryParam = false;
    url += "".concat(prefix).concat(paramName, "=").concat(queryParams[paramName]);
  }
  return url;
};

